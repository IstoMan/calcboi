## Safe Area Context

### Provider Setup

```tsx
// ✅ CORRECT - Wrap root in SafeAreaProvider
import { SafeAreaProvider, SafeAreaView } from 'react-native-safe-area-context';

export default function App() {
  return (
    <SafeAreaProvider>
      <SafeAreaView className="flex-1" edges={['top', 'bottom']}>
        {/* content */}
      </SafeAreaView>
    </SafeAreaProvider>
  );
}
```

### Edge Control

```tsx
// Control which edges apply insets
<SafeAreaView edges={['top', 'bottom']} /> // Top and bottom only
<SafeAreaView edges={['top', 'right', 'bottom', 'left']} /> // All edges
<SafeAreaView edges={[]} /> // No edges (equivalent to regular View)

// Use useSafeAreaInsets() hook for custom logic
import { useSafeAreaInsets } from 'react-native-safe-area-context';

const insets = useSafeAreaInsets();
// insets.top, insets.bottom, insets.left, insets.right
```

